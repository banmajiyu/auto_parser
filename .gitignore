# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 解析产物（保留目录结构，忽略其中文件）----
out/*
!out/.gitkeep

# ---- Kaitai 生成代码（由 scripts/compile_ksy.py 从 ksy/ 重新生成）----
generated/

# ---- 临时脚本 ----
_check_*.py
_gen_*.py

# ---- 系统文件 ----
.DS_Store
Thumbs.db

# ---- 待解析输入（保留目录结构，忽略其中文件；本地样本不入库）----
in/*
!in/.gitkeep

# ---- 测试（test/ 全量纳入提交：用例 + 真实样本 sample.hk）----
# 逐类反选而不是 `!test/**`，避免把 test/__pycache__ 也一起收进仓库
!test/
!test/**/*.py
!test/*.hk
!test/*.md
.pytest_cache/

# ---- VSCode ----
.vscode/*